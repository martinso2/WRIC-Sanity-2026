<script>
    var token = '';
            var clientId = '181';
            function checkDOBAppended(caseName) {
                let caseNameSplit = caseName.split("-")
                let check = false
                caseNameSplit.forEach(function (itm, idx) {
                    if (checkIsDateAndValidFormat(itm)) {
                        check = true
                    }
                })
        return check
            }
            function checkIsDateAndValidFormat(dateStr) {
                if (dateStr != '') {
                    dateStr = dateStr.trim()
                }
                var dt = new Date(dateStr);
                if (isNaN(dt.getTime())) { //Checked for date
                    return false; //Return false if not date.
                } else if (moment(dateStr, 'MM/DD/YYYY', true).isValid()) {
                    return true; //Return true.
                }
                return false; //Return false if not date.
            }
</script>
