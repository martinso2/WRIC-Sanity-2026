<script src="/js/jquery.maskssn.js?v=6.1.2.65" type="text/javascript"></script>
<script> var defaultcountry = "US"</script>

<script>
    var utilsScriptUrl = window.location.origin + '/js/Scripts/intlTelInput/utils.js?v=6.1.2.65'
</script>
<script src="/js/Scripts/intlTelInput/PlanstreetMobileInput.js?v=6.1.2.65" type="text/javascript"></script>

<script type="text/javascript">
    var showTeams = '0' * 1
    var client_Id = '181';
    var current_form_data = null;
    var clientName = 'Womens Rights Information Center';
    var clientImageUrl = '/181/Documents/Organization/ClientLogo190111820240450.png';
    var appUrl = 'https://app.planstreetinc.com/';
    var richtext;
    var dateFormatForMoment = 'MM/DD/YYYY';
    var isWeekEndsOff = true;
    var dteDobDate;
    var OrgAuth = '0';
    var IsLinkedWithPayment = false;
    var PaymentObject = null;
    var paymentResponse = null;
    var ssnNumberUnmasked = "";
    var ssnWithoutHyphens = "";
    function triggerSave() {
         disabledOrEnabledCaseName('2');
        var form = document.getElementById('submitForm');
        if ($('#objProjectCase_FirstName').val() == '') {
            form.reportValidity()
            alertMessagePlanStreet(GenericMessage.ErrorTitle, GenericMessage.ErrorType, 'First Name is required.');
            $('html, body').animate({
                scrollTop: $('#objProjectCase_FirstName').offset().top - 150
            }, 500);
             disabledOrEnabledCaseName('2');
            return false
        }
        if ($('#objProjectCase_LastName').val() == '') {
            form.reportValidity()
            alertMessagePlanStreet(GenericMessage.ErrorTitle, GenericMessage.ErrorType, 'Last Name is required.');
            $('html, body').animate({
                scrollTop: $('#objProjectCase_LastName').offset().top - 150
            }, 500);
             disabledOrEnabledCaseName('2');
            return false
        }
        $("#caseNameHidden").val($('#objProjectCase_FirstName').val() + " " + $('#objProjectCase_LastName').val())

        var DefaultCaseNameFormat = '2'
        var ClientPortalConfig = '0'
        if (DefaultCaseNameFormat == null || DefaultCaseNameFormat == "" || (DefaultCaseNameFormat * 1) == 2) {
            let person_identifier = getLatestPersonIdentifierNo()
            $("#objProject_Caption").val($("#caseNameHidden").val() + ' - ' + ((person_identifier * 1) + 1))
        } else
            if ((DefaultCaseNameFormat * 1) == 1) {
                if ($("#objProjectCase_CaseNumber").length > 0 && $("#objProjectCase_CaseNumber").val() != "") {
                    $("#objProject_Caption").val($("#caseNameHidden").val() + ' - ' + $("#objProjectCase_CaseNumber").val())
                } else {
                    let person_identifier = getLatestPersonIdentifierNo()
                    $("#objProject_Caption").val($("#caseNameHidden").val() + ' - ' + ((person_identifier * 1) + 1))
                }
            } else
                if ((DefaultCaseNameFormat * 1) == 3) {
                    if ($("#objProjectCase_DOB").val() != "") {
                        let dob = new Date($("#objProjectCase_DOB").val())
                        $("#objProject_Caption").val($("#caseNameHidden").val() + (dob != "Invalid Date" ? ' - ' + dob.toLocaleDateString("en-US", { year: 'numeric', month: '2-digit', day: '2-digit' }) : ""))//, { year: 'numeric', month: 'long', day: 'numeric' }
                    }
                } else
                    if ((DefaultCaseNameFormat * 1) == 4) {
                        if ($("#objProjectCase_DOB").val() != "") {
                            let dob = new Date($("#objProjectCase_DOB").val())
                            $("#objProject_Caption").val($("#caseNameHidden").val() + (dob != "Invalid Date" ? ' - ' + dob.toLocaleDateString("en-US", { year: 'numeric', month: '2-digit', day: '2-digit' }) : ""))//, { year: 'numeric', month: 'long', day: 'numeric' }
                            if ($("#objProjectCase_CaseNumber").length > 0 && $("#objProjectCase_CaseNumber").val() != "") {
                                $("#objProject_Caption").val($("#objProject_Caption").val() + ' - ' + $("#objProjectCase_CaseNumber").val())
                            } else {
                                let person_identifier = getLatestPersonIdentifierNo()
                                $("#objProject_Caption").val($("#objProject_Caption").val() + ' - ' + ((person_identifier * 1) + 1))
                            }
                        } else
                            if ($("#objProjectCase_CaseNumber").length > 0 && $("#objProjectCase_CaseNumber").val() != "") {
                                $("#objProject_Caption").val($("#caseNameHidden").val() + ' - ' + $("#objProjectCase_CaseNumber").val())
                            } else {
                                let person_identifier = getLatestPersonIdentifierNo()
                                $("#objProject_Caption").val($("#caseNameHidden").val() + ' - ' + ((person_identifier * 1) + 1))
                            }
                    }
                    /*else if ((DefaultCaseNameFormat * 1) == 5 && typeof $('input[name="objProjectCase.SSN"]').val() != "undefined") {*/
                    else if ($("#SSN_Require").is(":visible")) {
                        let ssn = $('input[name="objProjectCase.SSN"]').val()
                        if (ssnWithoutHyphens !== '') {
                            ssn = ssnWithoutHyphens
                        }
                        if (ssn == "") {
                            alertMessagePlanStreet(GenericMessage.ErrorTitle, GenericMessage.ErrorType, 'Social Security Number is required.');
                            return false
                        }
                        if (ssn.length != 9) {
                            alertMessagePlanStreet(GenericMessage.ErrorTitle, GenericMessage.ErrorType, 'Social Security Number is invalid.');
                            return false
                        }
                        $("#objProject_Caption").val($("#caseNameHidden").val() + (' - ' + ssn.substr(ssn.length - 4)))
                    } else {
                        $("#objProject_Caption").val($("#caseNameHidden").val())
                    }
        if ($('#objProject_Caption').length > 0 && $('#objProject_Caption').val() == '') {
            form.reportValidity()
            alertMessagePlanStreet(GenericMessage.ErrorTitle, GenericMessage.ErrorType, 'Caption is required.');
            $('html, body').animate({
                scrollTop: $('#objProject_Caption').offset().top - 150
            }, 500);
             disabledOrEnabledCaseName('2');
            return false
        }
        try {
            if ($('#objProjectCase_Email').val() != '' && (navigator.userAgent.toLowerCase().indexOf('firefox') !== -1)) {
                $('#objProjectCase_Email').val($('#objProjectCase_Email').val().trim())
            }
        } catch (e) {
        }
        if ($('#objProjectCase_Email').val() != '' && !validateEmail($('#objProjectCase_Email').val())) {
            form.reportValidity()
            alertMessagePlanStreet(GenericMessage.ErrorTitle, GenericMessage.ErrorType, 'Email is invalid.');
            $('html, body').animate({
                scrollTop: $('#objProjectCase_Email').offset().top - 150
            }, 500);
             disabledOrEnabledCaseName('2');
            return false
        }
        else {
            let resdata = ValidateRequireFields($('#ClientDetails').val());
            if (resdata.length > 0) {
                alertMessagePlanStreet("Warning", GenericMessage.WarningType, "" + resdata + "");
                validationSummary = "";
                disabledOrEnabledCaseName('2');
                return
            }
            let resdataforaddress = ValidateRequireFieldsForAddress($('#ClientDetails').val());
            if (resdataforaddress.length > 0) {
                alertMessagePlanStreet("Warning", GenericMessage.WarningType, "" + resdataforaddress + "");
                validationSummary = "";
                disabledOrEnabledCaseName('2');
                return
            }

        }

        if (!validateMobileInputs()) {
             disabledOrEnabledCaseName('2');
            return false
        }

        if (showTeams && $("#cmbProjectTeams").length > 0) {
            if ($("#cmbProjectTeams").val().length == 0) {
                alertMessagePlanStreet(GenericMessage.ErrorTitle, GenericMessage.ErrorType, 'Please select Team');
                $('html, body').animate({
                    scrollTop: $('#cmbProjectTeams').offset().top - 150
                }, 500);
                 disabledOrEnabledCaseName('2');
                return false
            }
        }

        if ((ClientPortalConfig * 1) == 1 && $('#objProjectCase_Email').val().trim() != "") {
            validateEmailPublicCase(); // check if email already exists or not in case of client portal
        } else {

            resetPayments();
            var amount = calculatePayment();
            if (amount > 0 && (IsLinkedWithPayment == false || PaymentObject == null)) {
                alertMessagePlanStreet(GenericMessage.ErrorTitle, GenericMessage.ErrorType, 'Card detail required.');
                 disabledOrEnabledCaseName('2');
                return false;
            }

            if (IsLinkedWithPayment == true && PaymentObject != null) {
                paymentResponse = SubmitPayment();
                if (paymentResponse == null || paymentResponse.result==false) {
                    alertMessagePlanStreet(GenericMessage.ErrorTitle, GenericMessage.ErrorType, 'Payment failed please check card detail.');
                    hideLoader();
                     disabledOrEnabledCaseName('2');
                    return false;
                }
            }
            $('#publicIntakeSubmit').trigger('click') // direct submit and validate on backend based on config
        }

    }

    function getLatestPersonIdentifierNo() {
        let person_identifier = ""
        $.ajax({
            type: "GET",
            async: false,
            contentType: "application/json; charset=utf-8",
            url: apiServer + "api/Public/GetLatestPersonIdentifierNo?ClientId=" + client_Id,
            beforeSend: function (request) {
                request.setRequestHeader("Authorization", "Bearer " + token);
            },
            success: function (data) {
                if (!data.is_error) {
                    person_identifier = data.result
                }
            }
        });
        return person_identifier;
    }

    function validateEmailPublicCase() {
        showLoader();
        $.ajax({
            cache: false,
            url: apiServer + "api/Public/CheckExistingClient",
            method: 'GET',
            data: {
                ClientId: client_Id,
                userName: $('input[name="objProjectCase.Email"]').val(),
            },
            beforeSend: function (request) {
                request.setRequestHeader("Authorization", "Bearer " + token);
            },
            success: function (data) {
                if (data) {
                    //hideLoader();
                    if (OrgAuth == "1") {
                        ShowSecurityPopUp();
                    }
                    else {
                        resetPayments();
                        var amount = calculatePayment();
                        if (amount > 0 && (IsLinkedWithPayment == false || PaymentObject == null)) {
                            alertMessagePlanStreet(GenericMessage.ErrorTitle, GenericMessage.ErrorType, 'Card detail required.');
                            return false;
                        }

                        if (IsLinkedWithPayment == true && PaymentObject != null) {
                            paymentResponse = SubmitPayment();
                            if (paymentResponse == null || paymentResponse.result == false) {
                                alertMessagePlanStreet(GenericMessage.ErrorTitle, GenericMessage.ErrorType, 'Payment failed please check card detail.');
                                hideLoader();
                                return false;
                            }
                        }
                        $('#publicIntakeSubmit').trigger('click')
                       // submitRequest();
                    }
                }
                else {
                    hideLoader();
                    alertMessagePlanStreet(GenericMessage.ErrorTitle, GenericMessage.ErrorType, "Email Already Exists");
                }
            },
            error: function (msg) {
                hideLoader();
            }
        });
    }
    String.prototype.replaceAt = function (index, character) {
        return this.substr(0, index) + character + this.substr(index + character.length);
    }

    //var $ssn = $('#objProjectCase_HiddenSSN');
    var $ssnVal = $('#objProjectCase_SSN');
    $ssnVal.unmask2().maskSSN('999-99-9999', { maskedChar: 'X', maskedCharsLength: 5 });
    window.onload = function () {
        window.scrollTo(0, 0);
    };

    $(document).ready(function () {

        let isMobile = window.matchMedia("only screen and (max-width: 760px)").matches;

        if (isMobile) {
            $("#objProjectCase_SSN").mask("999-99-9999");

            $("#objProjectCase_SSN").on("focus", function () { ssnFocus(); });
            $("#objProjectCase_SSN").on("blur", function () { ssnBlur(); });
            // Add keypress event to prevent alphabets
            $("#objProjectCase_SSN").on("keypress", function (e) {
                return isNumberOrHyphen(e);
            });
        } else {
            var $ssnVal = $('#objProjectCase_SSN');
            $ssnVal.unmask2().maskSSN('999-99-9999', { maskedChar: 'X', maskedCharsLength: 5 });
        }

        var logoPath = clientImageUrl.replace("../", '');
        var x = logoPath.replace("~", '');
        $("#headingClientName").html(clientName);
        if (clientImageUrl == '') {
            $("#imageClientLogo").attr("src", appUrl + 'Content/images/logo_light.png');
        }
        else {
            var blobUrl = "https://apidemo.planstreetinc.com/api/blob/url/";
            var container = "production";
            blobUrl = blobUrl + container;
            $("#imageClientLogo").attr("src", blobUrl + x);
        }

        loadForm();
        InitializeDateControls();

        $(document).on('submit', '#submitForm', function (e) {
            e.preventDefault();
        })
        let CaseClientDetailsSettings = localStorage.getItem("CaseClientDetailsSettings");
        if (CaseClientDetailsSettings && CaseClientDetailsSettings != "") {
            CaseClientDetailsSettings = JSON.parse(CaseClientDetailsSettings)

            for (var key in CaseClientDetailsSettings) {
                if (CaseClientDetailsSettings.hasOwnProperty(key)) {
                    let inputId = key.replace("_show", "");
                    inputId = "objProjectCase_" + inputId
                    if (!CaseClientDetailsSettings[key]) {
                        $('#' + inputId).closest('.clientDetailFeild').remove()
                    }

                }
            }
        }
        let DefaultCaseNameFormatGlobal = '2'
        disabledOrEnabledCaseName(DefaultCaseNameFormatGlobal);// if case name configuration not manual
        if ((DefaultCaseNameFormatGlobal * 1) != 6)  // its mean manual case name
        {
            $(document).on('keyup', '#objProjectCase_FirstName', function () {
                setCaseName(DefaultCaseNameFormatGlobal * 1)
            })
            $(document).on('keyup', '#objProjectCase_LastName', function () {
                setCaseName(DefaultCaseNameFormatGlobal * 1)
            })
            $(document).on('change', '#objProjectCase_DOB', function () {
                setCaseName(DefaultCaseNameFormatGlobal * 1)
                setAge($('#objProjectCase_DOB').val())
            })
            $(document).on('keyup', '#objProjectCase_CaseNumber', function () {
                setCaseName(DefaultCaseNameFormatGlobal * 1)
            })
            $(document).on('keyup', '#objProjectCase_SSN', function () {
                setCaseName(DefaultCaseNameFormatGlobal * 1)
            })

        } else { }
        caseNameFormatePlaceHolderPopulation(DefaultCaseNameFormatGlobal)
        $(document).on('keyup', '#objProject_Caption', function () {
            $('#caseNameHidden').val($(this).val())
        })
        $(document).on('change', '#objProjectCase_DOB', function () {
            setAge($('#objProjectCase_DOB').val())
        })

        if (showTeams) {
            $("#cmbProjectTeams").multiselect({
                buttonWidth: '100%',
                maxHeight: 280,
                buttonClass: 'form-control',
                nonSelectedText: 'No team selected',
                onChange: function (option, checked, select) {
                    $("#spnTeamsError").text("");
                }
            });
            $("#cmbProjectTeams").val([]).multiselect("refresh");
        }
    });

    function isNumberOrHyphen(e) {
        var charCode = e.which ? e.which : e.keyCode;
        if ((charCode < 48 || charCode > 57) && charCode !== 45) {
            e.preventDefault();
            return false;
        }
        return true;
    }

    function ssnFocus() {
        $("#objProjectCase_SSN").val(ssnNumberUnmasked);
    }
    function ssnBlur() {
        var charactercount = 0;
        var characterx = '';
        ssnNumberUnmasked = $("#objProjectCase_SSN").val();
        if (ssnNumberUnmasked.length >= 6) {
            $("#objProjectCase_SSN").val('XXX-XX' + ssnNumberUnmasked.slice(6));
        }
        else {
            charactercount = ssnNumberUnmasked.length;
            for (var i = 0; i < charactercount; i++) {
                if (i == 3 || i == 6) {
                    characterx += '-'
                }
                else {
                    characterx += 'X'
                }
            }
            $("#objProjectCase_SSN").val(characterx + ssnNumberUnmasked.slice(charactercount));
        }
        ssnWithoutHyphens = ssnNumberUnmasked.replace(/-/g, '');
    }
    function setDollerAmount(content, e) {
        if (e.which != 8 && e.which != 0 && (e.which < 45 || e.which > 57)) {
            return false;
        }
        else {
            var dataval = $(content).val();
            var repval = dataval.replace($('#DefaultCurrency').val(), "");
            $(content).val($('#DefaultCurrency').val() + repval);
            return true;
        }
    }
    $("#objProjectCase_strHouseholdMarketRent").keypress(function (e) {
        if (!setDollerAmount("#objProjectCase_strHouseholdMarketRent", e)) {
            return false;
        }
    });
    $("#objProjectCase_strHouseholdResidentRent").keypress(function (e) {
        if (!setDollerAmount("#objProjectCase_strHouseholdResidentRent", e)) {
            return false;
        }
    });
    $("#objProjectCase_strBalanceDue").keypress(function (e) {
        if (!setDollerAmount("#objProjectCase_strBalanceDue", e)) {
            return false;
        }
    });

    $("input[type=number]").bind("keyup keydown keypress", function (e) {
        if (e.keyCode == "38" || e.keyCode == "40") {
            return false;
        }
    });
    var DefaultCurrency = '';
    function changeCurrencyFormatInInputsPlaceHolders() {
        if (DefaultCurrency != '') {
            if (typeof DefaultCurrency == "object") {
                DefaultCurrency = DefaultCurrency.value
            }
            $('input').each(function () {
                let placeholder = $(this).attr('placeholder');
                if (typeof placeholder != 'undefined' && placeholder.indexOf('$') > -1) {
                    placeholder = placeholder.replace("$", DefaultCurrency)
                    let a = document.createElement('span');
                    a.innerHTML = placeholder;
                    this.setAttribute('placeholder', a.textContent)
                }
            })
        }
    }

    function saveForm() {
        var formData = current_form_data;
        var parseConfigData = JSON.parse($("#json").val());

        ssnWithoutHyphens = $('input[name="objProjectCase.SSN"]').val()
        if (ssnWithoutHyphens && ssnWithoutHyphens.length != 0 && ssnWithoutHyphens.length != 9) {
            alertMessagePlanStreet(GenericMessage.ErrorTitle, GenericMessage.ErrorType, "Social Security Number is Invalid");
            return;
        }

        // check for casename before submission
        if ($('input[name="objProject.Caption"]').val().trim() == "") {
            alertMessagePlanStreet(GenericMessage.ErrorTitle, GenericMessage.ErrorType, "Something went wrong, please try again later.");
            return false;
        }

        /*
        if (ssnWithoutHyphens == '') {
            ssnWithoutHyphens == $('input[name="objProjectCase.SSN"]').val();
        }
        */

        if (formData != '') {
            showLoader();
            var programDesireValue = "";
            var EmailNotification = "";
            $.each(formData, function (index, item) {
                if (item != null) {
                    if (typeof item.programDesired != 'undefined') {
                        programDesireValue = item.programDesired;
                    }
                }
            });
            if (typeof formData.notifyAdvocacy != 'undefined') {
                if (formData.notifyAdvocacy == true) {
                    EmailNotification = "Advocacy@txfne.com";
                }
            }
            if (typeof formData.notifyAdvocacy2 != 'undefined') {
                if (formData.notifyAdvocacy2 == true) {
                    EmailNotification = "Micala@txfne.com";
                }
            }
            if (typeof formData.notifyAdvocacy1 != 'undefined') {
                if (formData.notifyAdvocacy1 == true) {
                    EmailNotification = "ForensicInterview@txfne.com";
                }
            }
            if (typeof formData.counseling != 'undefined') {
                if (formData.counseling == true) {
                    EmailNotification = "katelynne@txfne.com";
                }
            }

            parseMobileInputs()
            let _obj = {
                Caption: $('input[name="objProject.Caption"]').val(),
                FirstName: $('input[name="objProjectCase.FirstName"]').val(),
                MiddleName: $('input[name="objProjectCase.MiddleName"]').val(),
                LastName: $('input[name="objProjectCase.LastName"]').val(),
                DOB: ($('input[name="objProjectCase.DOB"]').length > 0 ? $('input[name="objProjectCase.DOB"]').val() : ""),
                //HiddenSSN: $('input[name="objProjectCase.HiddenSSN"]').val(),
                SSN: ssnWithoutHyphens,
                Mobile: $('input[name="objProjectCase.Mobile"]').val(),
                PhoneNo: $('input[name="objProjectCase.PhoneNo"]').val(),
                AlternateContactNo: $('input[name="objProjectCase.AlternateContactNo"]').val(),
                Email: $('input[name="objProjectCase.Email"]').val(),
                AlternateEmail: $('input[name="objProjectCase.AlternateEmail"]').val(),
                EmergencyContactName: $('input[name="objProjectCase.EmergencyContactName"]').val(),
                EmergencyContactNo: $('input[name="objProjectCase.EmergencyContactNo"]').val(),
                EmergencyContactRelationship: $('input[name="objProjectCase.EmergencyContactRelationship"]').val(),
                EducationLevel: $('input[name="objProjectCase.EducationLevel"]').val(),
                Veteran: $('select[name="objProjectCase.Veteran"]').val(),
                Disabled: $('select[name="objProjectCase.Disabled"]').val(),
                ProgramDesired: programDesireValue,
                strEmailNotification: EmailNotification,
                CaseAdminData: JSON.stringify(parseConfigData),
                CaseData: JSON.stringify(formData),
                CaseNumber: $('input[name="objProjectCase.CaseNumber"]').val(),
                ClientId: client_Id
            }
            if (showTeams) {
                _obj.cmbProjectTeams = $('#cmbProjectTeams').val().toString();
            }
            if ('1' * 1 == 0) {
                grecaptcha.enterprise.ready(function () {
                    grecaptcha.enterprise.execute('6LesHSIpAAAAAEDPraWHpQ_eJEAVU2X4gi1l40u2', { action: 'submit' }).then(function (gtoken) {
                        submitFormData(_obj, formData, gtoken)
                    });
                });
            } else {
                submitFormData(_obj, formData, '')
            }

        }
    }

    function submitFormData(_obj, formData, gtoken) {
        _obj.GoogleCaptchaToken = gtoken;
        $.ajax({
            type: "POST",
            contentType: "application/json; charset=utf-8",
            url: apiServer + "api/Public/SubmitCaseManagementPublicData?ClientId=" + client_Id,
            beforeSend: function (request) {
                request.setRequestHeader("Authorization", "Bearer " + token);
            },
            data: JSON.stringify(_obj),
            success: function (data) {
                if (data.is_error == false) {

                    //var payload = JSON.parse(JSON.stringify(_obj));
                    //delete payload.CaseAdminData
                    //payload.Container = payload.CaseData && JSON.parse(payload.CaseData) && JSON.parse(payload.CaseData).Container ? JSON.parse(payload.CaseData).Container : payload.CaseData
                    //delete payload.CaseData
                    //await permInsertUpdate("Intake", "Intake", payload)

                    let resultArray = data.result.split(",");
                    let projectId = resultArray[0];
                    let caseManagementId = resultArray[1];

                                if (`0` * 1 > 0) {
                                    let emailsKeys = Object.keys(formData.Container).filter(x => x.includes("Restrict_Parent_Component"))
                                    let emails = ''
                                    emailsKeys.forEach((itm, idx) => {
                                        if (Array.isArray(formData.Container[itm])) {
                                            emails = [...emails, ...formData.Container[itm]]
                                        } else {
                                            emails.push(formData.Container[itm])
                                        }
                                    })
                                    if (emails.length > 0) {
                                        sendRestrictedIntakeEmails(emails, projectId);
                                    }
                                }

                    SaveProjectDocuments($("#clientName").val(), projectId, caseManagementId);
                    SaveAddress(caseManagementId, 1, function () {
                        if (IsLinkedWithPayment == true && PaymentObject != null && paymentResponse != null && paymentResponse.result) {
                            createAutoInvoice(data.result, $('input[name="objProjectCase.Email"]').val(), paymentResponse.Amount)
                        }
                        IsLinkedWithPayment = false;
                        PaymentObject = null;
                        alertMessagePlanStreetCallBack(GenericMessage.SaveTitle, GenericMessage.SuccessType, data.message, function (i) {
                            SendProjectCreateUpdateEmail(projectId, "Created", $("#objProject_Caption").val(), $("#cn").val());
                        });
                    });

                }
                else {
                    hideLoader();
                    alertMessagePlanStreet(GenericMessage.ErrorTitle, GenericMessage.ErrorType, data.message);
                    resetMobileInputs();
                }
            },
            error: function (xhr, status, error) {
                resetMobileInputs();
                hideLoader();
                console.log("Error:", error);
            }
        });
    }

    function sendRestrictedIntakeEmails(emails, projectId) {
        var ClientPrefix = $("#clientName").val()
        if (!ClientPrefix) {
            // get from URL
            ClientPrefix = window.location.pathname.split('/')[1]
        }
        // send email here
        emails.forEach((email, idx) => {
            if (email) {
                $.ajax({
                    beforeSend: function (request) {
                        request.setRequestHeader("Authorization", "Bearer " + token);
                    },
                    contentType: "application/json; charset=utf-8",
                    type: "POST",
                    async: false,
                    url: apiServer + "api/Common/CreatePublicIntakeLink",
                    data: JSON.stringify({
                        'projectID': projectId,
                        'emails': email,
                        'CreatedBy': 0,
                        'LinkUrl': window.location.origin + '/' + ClientPrefix + '/PublicForm/RestrictedIntake/' + projectId,
                        'ValidityPeriod': "15.00:00:00"
                    }),
                    success: function (data) {
                        if (data.Data) {
                            let linkId = data.Data
                            let sendIntakeUrl = `${window.location.origin}/${ClientPrefix}/PublicForm/RestrictedIntake/${projectId}?key=${linkId}`
                            let Body = `Intake is shared. <a href="${sendIntakeUrl}" target="_blank">Click here to view!</a>`
                            $.ajax({
                                beforeSend: function (request) {
                                    request.setRequestHeader("Authorization", "Bearer " + token);
                                },
                                contentType: "application/json; charset=utf-8",
                                type: "POST",
                                async: false,
                                url: apiServer + `api/Common/SendRestrictedIntakeEmail`,
                                data: JSON.stringify({
                                    'CaseName': SanitizeString($("#objProject_Caption").val()),
                                    'Emails': email,
                                    'Body': Body
                                }),
                                success: function (data) {
                                    //if (data.Data) {

                                    //}
                                }
                            });
                        }
                    }
                });
            }
        })
    }
    function SendAddedTeamEmail(projectID, AddedTeams, projectName) {
        if (!isNumeric(projectID)) {
            return;
        }
        $.ajax({
            type: "POST",
            url: "/StreetPortfolio/Projects/SendAddedTeamEmail",
            data: { 'projectID': projectID, 'ProjectName': SanitizeString(projectName), 'AddedTeams': AddedTeams },
            success: function (data) {
                hideLoader();
            },

        });
    }

    function loadForm() {
        var formJson = $("#json").val();
        if (formJson != "") {
            let client_details = $("#ClientDetails").val();
            try {

                let CaseClientDetailsSettings = client_details;
                if (CaseClientDetailsSettings && CaseClientDetailsSettings != "") {
                    CaseClientDetailsSettings = JSON.parse(CaseClientDetailsSettings)
                    let CaseDetailsIsRequired = null;
                    if ('CaseDetailsIsRequired' in CaseClientDetailsSettings) {
                        CaseDetailsIsRequired = CaseClientDetailsSettings.CaseDetailsIsRequired; // get required object
                    }
                    for (var key in CaseClientDetailsSettings) {
                        if (CaseClientDetailsSettings.hasOwnProperty(key)) {
                            let inputId = key.replace("_show", "");
                            inputId = "objProjectCase_" + inputId
                            if (!CaseClientDetailsSettings[key]) {
                                /*hiding age on dob*/
                                if (inputId === "objProjectCase_DOB") {
                                    $("#div_objProjectCase_Age").hide();
                                }
                                /*hiding age on dob*/
                                $('#' + inputId).closest('.clientDetailFeild').remove()
                            } else {
                                // -------- Require * show hide ------------- //
                                inputId = inputId.replace("objProjectCase_", "");
                                let requireInput = inputId;
                                requireInput = requireInput + '_Require';
                                if (requireInput in CaseDetailsIsRequired) {
                                    if (!CaseDetailsIsRequired[requireInput]) { $('#' + requireInput).hide(); }
                                    else { $('#' + requireInput).show(); }
                                }
                            }
                        // -------- Require * show hide ------------- // }

                        }
                    }
                    // ---- Patch for email asterick becuase its diabled from configuration ------ //
                    if ('Email_Require' in CaseDetailsIsRequired) {
                        CaseDetailsIsRequired['Email_Require'] ? $('#Email_Require').show() : $('#Email_Require').hide();
                    }
            // ---- Patch for email asterick becuase its diabled from configuration ------ //
                } else {
                    $('.clientDetailFeild').each(function () {
                        let input_name = $(this).find('input').attr('id')
                        if (input_name != "objProjectCase_FirstName" && input_name != "objProjectCase_LastName" && input_name != "objProjectCase_Email") {
                            $(this).remove()
                        }
                    })
                }
            } catch (e) {
                hideLoader()
            }
        }
        var get_config = JSON.parse(formJson);
        $(".formTitle").text(get_config.name);
        var get_components = JSON.parse((typeof get_config.config != 'undefined' ? get_config.config : get_config[0].config));
        try {
            get_components.components.forEach((itm, idx) => {
                get_components.components[idx] = fromioApplyPlanStreetMask(itm)
            })
        } catch (e) { }
        if (JSON.stringify(get_components).includes("{clientUrlWithPrefix}")) {
            get_components = replaceClientUrlWithPrefix(get_components);
        }
        Formio.createForm(document.getElementById('formView'), get_components).then((form) => {

            form.on('change', function (changed) {
                current_form_data = changed.data
            });
            form.on('submit', function (submission) {
                current_form_data = submission.data
                saveForm()
            });
            form.on('error', function (err) {
                alertMessagePlanStreet("Warning", GenericMessage.WarningType, "" + err[0].message + "");
                if ($(".formio-error-wrapper").length) {
                    $('html, body').animate({
                        scrollTop: $(".formio-error-wrapper").offset().top - 100
                    }, 500);
                }                
                hideLoader()
            });
            $(document).on("click", "#publicIntakeSubmit", function () {
                form.submit()
            })
            $('button[ref="submitButton"]').hide()
        });

        Formio.prototype.downloadFile = function (a, b) {
            const dfd = new $.Deferred();
            return dfd.promise();
        }
    }
    function InitializeDateControls() {

        if ($("#objProjectCase_HouseholdLeasestart").length) {

            $("#objProjectCase_HouseholdLeasestart").kendoDatePicker({
               // dateInput: true,
                format: 'MM/dd/yyyy',
                change: function () {
                    var value = this.value();
                    let sDate = JSON.parse(JSON.stringify({ val: value }));
                    sDate = new Date(sDate.val);
                    if (value && (sDate !== "Invalid Date") && !isNaN(sDate)) {
                        sDate.setFullYear(value.getFullYear() + 1);
                        var HouseholdLeaseEnd = $("#objProjectCase_HouseholdLeaseEnd").data("kendoDatePicker");
                        HouseholdLeaseEnd.setOptions({
                            min: value
                        });
                        HouseholdLeaseEnd.value(sDate);
                    }
                }
            });
            $('#objProjectCase_HouseholdLeasestart').dateInputMask();
        }

        if ($("#objProjectCase_HouseholdLeaseEnd").length) {

            $("#objProjectCase_HouseholdLeaseEnd").kendoDatePicker({
               // dateInput: true,
                format: 'MM/dd/yyyy'
            });
            $('#objProjectCase_HouseholdLeaseEnd').dateInputMask();
        }

        if ($('#objProjectCase_DOB').length) {
            ////DOB Date//////
            $("#objProjectCase_DOB").kendoDatePicker({
                //dateInput: true,
                max: new Date(),
                format: 'MM/dd/yyyy',
                change: function () {
                    var value = this.value();
                    if (value > new Date()) {
                        this.value = new Date
                    }
                    triggerDobEvent()
                    let DefaultCaseNameFormatGlobal = '2'
                    setCaseName(DefaultCaseNameFormatGlobal * 1)
                    setAge($('#objProjectCase_DOB').val())
                },
                disableDates: function (date) {
                    var today = new Date();
                    return (date >= today);
                }
            });
            $('#objProjectCase_DOB').dateInputMask();
            /////
        }
    }
    function SendProjectCreateUpdateEmail(projectID, type, projectName, cn) {
        if (!isNumeric(projectID)) {
            return;
        }
        $.ajax({
            type: "GET",
            async: false,
            contentType: "application/json; charset=utf-8",
            url: apiServer + "api/Public/NewProjectCreationEMailByClientId?clientId=" + client_Id,
            beforeSend: function (request) {
                request.setRequestHeader("Authorization", "Bearer " + token);
            },
            data: { 'projectId': projectID, 'caption': SanitizeString(projectName), 'CreateOrEdit': type },
            success: function (data) {
                hideLoader();
                location.reload();
            },
            error: function (err) {
                hideLoader();
            }
        });
    }
</script>


                                                            <script>
    function calculatePayment() {
        var amount = $('[name="data[container][ddlServices]"]').val();
        if (typeof amount == 'undefined' || amount == "")
            amount = $('[name="data[container1][ddlServices]"]').val();
        if (typeof amount == 'undefined' || amount == "")
            amount = $('[name="data[container2][ddlServices]"]').val();
        if (typeof amount == 'undefined' || amount == "")
            amount = $('[name="data[container3][ddlServices]"]').val();
        if (typeof amount == 'undefined' || amount == "")
            amount = $('[name="data[container4][ddlServices]"]').val();
        if (typeof amount == 'undefined' || amount == "")
            amount = 0;
        amount = parseFloat(amount);
        return amount;
    }
    function resetPayments() {
        var amount = calculatePayment();

        if (amount < 1) {
            IsLinkedWithPayment = false;
            PaymentObject = null;
        }
    }
    function addPayment() {
         IsLinkedWithPayment = false;
         PaymentObject = null;
        var amount = calculatePayment();

        if (amount < 1) {
            IsLinkedWithPayment = false;
            PaymentObject = null;
            return;
        }


        var model = {
            FirstName: '',
            LastName: '',
            Email: '',
            Amount: amount
        };
        //$('[name="data[container][payment]').attr('disabled', true);
        showLoader();
        $("#AddPayment").empty();
        $("#AddPayment").load("/Donate/NewPayment", { payment: model });
        IsLinkedWithPayment = true;
    }
    function onPaymentSuccess(data, paymentGateway) {
        IsLinkedWithPayment = true;
        PaymentObject = data;

    }
    function SubmitPayment() {
        showLoader();
        var res = null;
        if (IsLinkedWithPayment == true && PaymentObject != null) {
            PaymentObject.FirstName = $('#objProjectCase_FirstName').val();
            PaymentObject.LastName = $('#objProjectCase_LastName').val();
            PaymentObject.Email = $('#objProjectCase_Email').val();
            $.ajax({
                url: "/Donate/CardPayment",
                dataType: "json",
                type: "Post",
                contentType: 'application/json; charset=utf-8',
                data: JSON.stringify(PaymentObject),
                async: false,
                success: function (response) {
                    res = response;
                },
                error: function (xhr, textStatus, errorThrown) {
                    res = null;
                }
            })
        }
        return res;
    }
    function createAutoInvoice(ProjectId, Email, Amount) {
        var dateNow = '05/21/2026';
        var userEmail = Email;
        var Selectedprojects = ProjectId;
        $.ajax({
            type: "POST",
            url: apiServer + "api/Public/CreateInvoice?ClientId=" + client_Id,
            dataType: "json",
            async: false,
            data: {
                IsAuto: true,
                CustomerId: "",
                BillingTypeId: 5,
                InvoiceNo: ("INV_" + Math.floor(Math.random() * 1000000)),
                TotalBill: Amount,
                Subtotal: Amount,
                TaxPercenage: 0,
                TaxAmount: 0,
                IsRevenue: 0,
                InvoiceTypeId: 1,
                Projects: Selectedprojects,
                DateIssued: dateNow,
                DueDate: dateNow,
                Address: '',
                Email: userEmail,
                Phone: '',
                InvoiceId: 0,
                Creator: null,
                Updater: null,
                Startdate: dateNow,
                EndDate: dateNow,
                IsSend: true,
                Description: "Medical Services",
                OrganizationEmail: $("#OrganizationEmail").val(),
                InvoiceTaskResourceDTO: [{
                    TaskId: 0,
                    ProjectId: ProjectId,
                    Description: "Medical Services",
                    Caption: "Medical Services",
                    Quantity: 1,
                    UnitPrice: Amount,
                    Duration: 0,
                    ActualLaborCost: 0,
                    FixedCost: 0,
                    Rate: 1,
                    Discount: 0,
                    TotalBill: Amount
                }],
                InvoiceStatusId: 3
            },
            beforeSend: function (request) {
            request.setRequestHeader("Authorization", "Bearer " + token);
        },
            success: function (data) {
                IsLinkedWithPayment = false;
                PaymentObject = null;
            }
        });
    }

                                                            </script>
