                    <input id="ClientDetails" name="ClientDetails" type="hidden" value="{&quot;DOB_show&quot;:true,&quot;Age_show&quot;:true,&quot;MiddleName_show&quot;:false,&quot;HiddenSSN_show&quot;:false,&quot;SSN_show&quot;:false,&quot;Address_show&quot;:true,&quot;apartment_show&quot;:true,&quot;CityId_show&quot;:true,&quot;ZipCode_show&quot;:true,&quot;County_show&quot;:true,&quot;StateId_show&quot;:true,&quot;CountryId_show&quot;:false,&quot;Mobile_show&quot;:true,&quot;PhoneNo_show&quot;:false,&quot;AlternateContactNo_show&quot;:false,&quot;AlternateEmail_show&quot;:false,&quot;EmergencyContactName_show&quot;:false,&quot;EmergencyContactNo_show&quot;:false,&quot;EmergencyContactRelationship_show&quot;:false,&quot;EducationLevel_show&quot;:true,&quot;Veteran_show&quot;:false,&quot;Disabled_show&quot;:false,&quot;strHouseholdMarketRent_show&quot;:false,&quot;strHouseholdResidentRent_show&quot;:false,&quot;HouseholdLeasestart_show&quot;:false,&quot;HouseholdLeaseEnd_show&quot;:false,&quot;strBalanceDue_show&quot;:false,&quot;CaseNumber_show&quot;:false,&quot;NutritionProgram_show&quot;:false,&quot;CareStartDate_show&quot;:false,&quot;CareEndDate_show&quot;:false,&quot;CareAmount_show&quot;:false,&quot;CaseDetailsIsRequired&quot;:{&quot;DOB_Require&quot;:true,&quot;MiddleName_Require&quot;:false,&quot;HiddenSSN_Require&quot;:false,&quot;SSN_Require&quot;:false,&quot;Address_Require&quot;:true,&quot;apartment_Require&quot;:false,&quot;CityId_Require&quot;:true,&quot;ZipCode_Require&quot;:false,&quot;County_Require&quot;:false,&quot;StateId_Require&quot;:false,&quot;CountryId_Require&quot;:false,&quot;Mobile_Require&quot;:true,&quot;PhoneNo_Require&quot;:false,&quot;AlternateContactNo_Require&quot;:false,&quot;AlternateEmail_Require&quot;:false,&quot;EmergencyContactName_Require&quot;:false,&quot;EmergencyContactNo_Require&quot;:false,&quot;EmergencyContactRelationship_Require&quot;:false,&quot;EducationLevel_Require&quot;:false,&quot;Veteran_Require&quot;:false,&quot;Disabled_Require&quot;:false,&quot;strHouseholdMarketRent_Require&quot;:false,&quot;strHouseholdResidentRent_Require&quot;:false,&quot;HouseholdLeasestart_Require&quot;:false,&quot;HouseholdLeaseEnd_Require&quot;:false,&quot;strBalanceDue_Require&quot;:false,&quot;CaseNumber_Require&quot;:false,&quot;NutritionProgram_Require&quot;:false,&quot;CareStartDate_Require&quot;:false,&quot;CareEndDate_Require&quot;:false,&quot;CareAmount_Require&quot;:false,&quot;Email_Require&quot;:true}}" />
                    <div id="forms">
                        <form id="submitForm" action="" method="post" enctype="multipart/form-data" target="upload_target">
                            <div class="row mb-5" style="min-height: 500px">

                                

                                <input autocomplete="off" class="form-control" data-val="true" data-val-required="*" id="objProject_Caption" name="objProject.Caption" type="hidden">

                                <input type="hidden" id="caseNameHidden" autocomplete="off" />
                                <div class="col-12 mb-3">
                                    <div class="card">
                                        <div id="clientDetailHeading" class="card-header card-collapsable">
                                            <h2 class="mb-0">
                                                <button type="button" class="btn btn-link btnlink" data-toggle="collapse" data-target="#clientDetailCollapse">Client Details</button>
                                            </h2>
                                        </div>
                                        <div id="clientDetailCollapse" class="collapse show mrg-btm-twenty card-body" aria-labelledby="clientDetailHeading">
                                            <div class="row">
                                                <div class="col-md-3 col-lg-3 marg">
                                                    <label class="label-mar">
                                                        First Name  <span style="color:red;">
                                                            <span class="field-validation-valid" id="spnFirstNameError">*</span>
                                                        </span>
                                                    </label>
                                                    <input autocomplete="off" class="form-control" id="objProjectCase_FirstName" name="objProjectCase.FirstName" type="text" value="" required>
                                                </div>
                                                <div class="col-md-3 col-lg-3 marg clientDetailFeild">
                                                    <label class="label-mar">
                                                        Middle Name
                                                        <span style="color:red; display:none;" id="MiddleName_Require">
                                                            <span class="field-validation-valid" id="spnLastNameError">*</span>
                                                        </span>
                                                    </label>
                                                    <input autocomplete="off" class="form-control" id="objProjectCase_MiddleName" name="objProjectCase.MiddleName" type="text" value="">
                                                </div>
                                                <div class="col-md-3 col-lg-3 marg ">
                                                    <label class="label-mar">
                                                        Last Name  <span style="color:red;">
                                                            <span class="field-validation-valid" id="spnLastNameError">*</span>
                                                        </span>
                                                    </label>
                                                    <input autocomplete="off" class="form-control" id="objProjectCase_LastName" name="objProjectCase.LastName" type="text" value="" required>
                                                </div>
                                                <div class="col-md-3 col-lg-3 marg clientDetailFeild">
                                                    <label class="label-mar">
                                                        Date of Birth
                                                        <span style="color:red; display:none;" id="DOB_Require">
                                                            <span class="field-validation-valid" id="spnLastNameError">*</span>
                                                        </span>
                                                    </label>
                                                    <input value="" autocomplete="off" class="form-control" data-val="true" data-val-date="The field DOB must be a date." id="objProjectCase_DOB" name="objProjectCase.DOB" style="cursor:pointer;" type="text" placeholder="mm/dd/yyyy">
                                                </div>
                                                <div class="col-md-3 col-lg-3 marg clientDetailFeild" id="div_objProjectCase_Age">
                                                    <label class="label-mar" for="objProjectCase_Age">
                                                        Age
                                                        <span style="color:red; display:none;" id="Age_Require">
                                                            <span class="field-validation-valid" id="spnLastNameError">*</span>
                                                        </span>
                                                    </label>
                                                    <input type="number" id="objProjectCase_Age" class="form-control" disabled />
                                                </div>
                                                <div class="col-md-3 col-lg-3 marg clientDetailFeild">
                                                    <label class="label-mar">
                                                        Social Security Number
                                                        
                                                        <span style="color:red; display:none;" id="SSN_Require">
                                                            <span class="field-validation-valid" id="spnLastNameError">*</span>
                                                        </span>
                                                        
                                                    </label>
                                                    <input class="form-control" id="objProjectCase_SSN" maxlength="11" name="objProjectCase.SSN" type="text" autocomplete="off" value="" >
                                                </div>

<script type="text/javascript">
    var autocomplete = "";
    var address1Field = "";
    var address2Field = "";
    var postalField = "";
    var addressId = `0`;
    var address = ``;
    var objProjectCase_ZipCode = ``;
    var objProjectCase_CityId = ``;
    var objProjectCase_StateId = ``;
    var StateShortName = ``;
    var objProjectCase_CountryId = ``;
    var objProjectCase_County = ``;
    var resourceId = "";
    var IsMedicalBilling = "False" === "True"
    var urlPost = "api/Address/SaveAddress";
                
    addressId = "";
    urlPost = "api/Public/SaveAddress?ClientId=" + 181;
                

    var resourceId = "";
    var ShowLandmark = `False`;
    var ShowDirections = `False`;
    var longitude = ``;
    var latitude = ``;
    var APIBaseURL = "https://apidemo.planstreetinc.com/";
    var isLandmarkAndDirectionsDivShow = false;
    var isGrid = false;
    var GridID = '[name="StreetName"]';
    var GridID2 = '#StreetName';
    var gridTable = "#kendo-grid";
    var rowEdit = null;
    function grid_beforeEdit(e, data) {
        data = data || {};
        var index = $((data.gridTable||gridTable) + '_active_cell').index();
        var field = $((data.gridTable || gridTable) + ' [role="rowgroup"]:eq(0) th:eq(' + index + ')').data().field;

        if (!e.model.isNew()) {
            if (false && field == 'Email' && (e.model.Email||'').length>0 ) {
                e.preventDefault();
            }
        }
            if ((false && ["County","ZipCode"].indexOf(field)>-1)) {
                e.preventDefault();
        }

        if (data && data.type ==6 && ["City", "County", "Country","State", "ZipCode"].indexOf(field) > -1) {
            e.preventDefault();
        }
        setTimeout(function (event, data) {
            data = data || {};
            if ($(data.GridID || GridID).length > 0) {

                address1Field = document.querySelector(data.GridID2 ||GridID2);
                rowEdit=$(address1Field).parent();
                //address1Field.addEventListener("keyup", () => {
                //    if (address1Field.value == '' || address1Field != address) {
                //        //if (document.querySelector("#objProjectCase_ZipCode")) {
                //        //    document.querySelector("#objProjectCase_ZipCode").value = '';
                //        //}
                //        //if (document.querySelector("#objProjectCase_CityId")) {
                //        //    document.querySelector("#objProjectCase_CityId").value = '';
                //        //}
                //        //if (document.querySelector("#objProjectCase_StateId")) {
                //        //    document.querySelector("#objProjectCase_StateId").value = '';
                //        //}
                //        //if (document.querySelector("#objProjectCase_CountryId")) {
                //        //    document.querySelector("#objProjectCase_CountryId").value = '';
                //        //}
                //        //if (document.querySelector("#objProjectCase_County")) {
                //        //    document.querySelector("#objProjectCase_County").value = '';
                //        //}
                //        //disableorEnabledAllFields(true);
                //    }
                //});

                //postalField = document.querySelector("#postcode");
                // Create the autocomplete object, restricting the search predictions to
                // addresses in the US and Canada.
                autocomplete = new google.maps.places.Autocomplete(address1Field, {
                    fields: ["address_components", "geometry"],
                    types: ["address"],
                });
                //$('#customermodal').modal('show');
                // When the user selects an address from the drop-dowModel, populate the
                // address fields in the form.
               //autocomplete.removeListener("place_changed", fillInAddress);
                //autocomplete.addListener("place_changed", fillInAddress);
                google.maps.event.clearInstanceListeners(autocomplete);
                google.maps.event.addListener(autocomplete, 'place_changed', fillInAddress.bind(null,data));

            }
        }.bind(this, e, data), 1000);
    }
    function initAutocomplete(_gridTable,data) {

        if (isGrid && false) {
            var grid = $(_gridTable || gridTable).data("kendoGrid");
            if (grid) {
                grid.bind("beforeEdit", (e)=>grid_beforeEdit(e,data));
            } else {
                setTimeout(() => initAutocomplete(_gridTable, data), 1000);
            }
        } else {
        address1Field = document.querySelector("#objProjectCase_Address");
        //$("#objProjectCase_ZipCode").attr("disabled", "disabled");
        //$("#objProjectCase_CityId").attr("disabled", "disabled");
        //$("#objProjectCase_StateId").attr("disabled", "disabled");
        //$("#objProjectCase_CountryId").attr("disabled", "disabled");
        //$("#objProjectCase_County").attr("disabled", "disabled");
            if (address1Field) {
                address1Field.addEventListener("keyup", () => {
                    //if (address1Field.value == '' || address1Field != address) {
                    //    if (document.querySelector("#objProjectCase_ZipCode")) {
                    //        document.querySelector("#objProjectCase_ZipCode").value = '';
                    //    }
                    //    if (document.querySelector("#objProjectCase_CityId")) {
                    //        document.querySelector("#objProjectCase_CityId").value = '';
                    //    }
                    //    if (document.querySelector("#objProjectCase_StateId")) {
                    //        document.querySelector("#objProjectCase_StateId").value = '';
                    //    }
                    //    if (document.querySelector("#objProjectCase_CountryId")) {
                    //        document.querySelector("#objProjectCase_CountryId").value = '';
                    //    }
                    //    if (document.querySelector("#objProjectCase_County")) {
                    //        document.querySelector("#objProjectCase_County").value = '';
                    //    }
                    //    //disableorEnabledAllFields(true);
                    //}
                });

                //postalField = document.querySelector("#postcode");
                // Create the autocomplete object, restricting the search predictions to
                // addresses in the US and Canada.
                autocomplete = new google.maps.places.Autocomplete(address1Field, {
                    fields: ["address_components", "geometry"],
                    types: ["address"],
                });
            }
            if ($('#customermodal').length > 0 && $('#customermodal').modal) {
                $('#customermodal').modal('show');
            }
      
        // When the user selects an address from the drop-dowModel, populate the
        // address fields in the form.
            if (autocomplete && autocomplete.addListener) {
                autocomplete.addListener("place_changed", fillInAddress);
            }
            // prevent users to edit the address feilds manually when medicalbilling env
            if (IsMedicalBilling) {
                $("#objProjectCase_ZipCode").prop("disabled", true).addClass("medBillDisabled");
                $("#objProjectCase_CityId").prop("disabled", true).addClass("medBillDisabled");
                $("#objProjectCase_County").prop("disabled", true).addClass("medBillDisabled");
                $("#objProjectCase_StateId").prop("disabled", true).addClass("medBillDisabled");
                $("#StateShortName").prop("disabled", true).addClass("medBillDisabled");
                $("#objProjectCase_CountryId").prop("disabled", true).addClass("medBillDisabled");
                $(document).on("keydown paste input change", ".medBillDisabled", function (e) { e.preventDefault(); });
            }

        }
    }


    function fillInAddress(_data) {

        // Get the place details fromModelthe autocomplete object.
        const place = autocomplete.getPlace();
        let address1 = "";
        let city = "";
        let county = "";
        let state = "";
        let shortstate = "";
        let zip = "";
        let country = "";
        console.log(place.geometry.location.lat());
        console.log(place.geometry.location.lng());
        // Get each component of the address from Modelodelhe place details,
        // and then filModel-in the corresponding field on the form.
        // pModelodelodelodeloStreet_AddressStreet_AddressStreet_Addressdelace.address_components are google.maps.GeocoderAddressComponent objects
        // which are documented at http://goo.gle/3l5i5Mr
        if (document.querySelector("#objProjectCase_ZipCode")) {
            document.querySelector("#objProjectCase_ZipCode").value = '';
        }
        if (document.querySelector("#objProjectCase_CityId")) {
            document.querySelector("#objProjectCase_CityId").value = '';
        }
        if (document.querySelector("#objProjectCase_StateId")) {
            document.querySelector("#objProjectCase_StateId").value = '';
            document.querySelector("#StateShortName").value = '';
        }
        if (document.querySelector("#objProjectCase_County")) {
            document.querySelector("#objProjectCase_County").value = '';
        }
        if (document.querySelector("#objProjectCase_CountryId")) {
            document.querySelector("#objProjectCase_CountryId").value = '';
        }
        if (document.querySelector("#objProjectCase_Address")) {
            document.querySelector("#objProjectCase_Address").value = '';
        }
        for (const component of place.address_components) {
            const types = component.types;

            if (types.includes("street_number") || types.includes("premise")) {
                address1 += component.long_name;
            }

            if (types.includes("route")) {
                address1 += " " + component.short_name;
            } else if (types.includes("sublocality_level_1")) {
                address1 += " " + component.long_name;
            }

            if (types.includes("postal_code")) {
                zip = component.long_name;
            }
            if (types.includes("postal_code_suffix")) {
                zip += "-" + component.long_name;
            }

            if (types.includes("locality")) {
                city = component.long_name;
            } else if (!city && types.includes("neighborhood")) {
                city = component.long_name;
            } else if (!city && types.includes("sublocality")) {
                city = component.long_name;
            } else if (!city && types.includes("sublocality_level_2")) {
                city = component.long_name;
            }

            if (types.includes("administrative_area_level_2")) {
                county = component.long_name.replace(/ County$/, "");
            }

            if (types.includes("administrative_area_level_1")) {
                state = component.long_name;
                shortstate = component.short_name;
            }

            if (types.includes("country")) {
                country = component.long_name;
            }
        }

        const setField = (selector, value) => {
            const el = document.querySelector(selector);
            if (el && value) el.value = value;
        };

        setField("#objProjectCase_Address", address1.trim());
        setField("#objProjectCase_ZipCode", zip);
        setField("#objProjectCase_CityId", city);
        setField("#objProjectCase_County", county);
        setField("#objProjectCase_StateId", (state));
        setField("#StateShortName", (shortstate));
        setField("#objProjectCase_CountryId", country);
        if (place.geometry && place.geometry.location) {
            longitude = place.geometry.location.lng();
            latitude = place.geometry.location.lat();
        }

        if (isGrid && rowEdit) {
                //rowEdit.text(address1)
                var grid = $(_data.gridTable ||gridTable).data("kendoGrid");
                var data = grid.dataSource.data();
                var index = data.map(e => e.uid).findIndex(e => e == $((_data.gridTable||gridTable) + '_active_cell').parent().data('uid'));
                if (index < 0) {
                    index = data.map(e => e.uid).findIndex(e => e == grid._current.parent().data('uid'));
                }

                var item = data[index];
                if (_data.type == 6) {
                    item.StreetAddress = address1;
                    item.City = document.querySelector("#objProjectCase_CityId").value
                    item.Country = document.querySelector("#objProjectCase_CountryId").value
                    item.County = document.querySelector("#objProjectCase_County").value
                    item.State = document.querySelector("#objProjectCase_StateId").value;
                    item.StateShortName = document.querySelector("#StateShortName").value;
                    item.Ste_Apt = document.querySelector("#objProjectCase_apartment").value;
                    item.ZipCode = document.querySelector("#objProjectCase_ZipCode").value;
                } else {
                    item.StreetName = address1;
                    item.CityName = document.querySelector("#objProjectCase_CityId").value
                    item.CountryName = document.querySelector("#objProjectCase_CountryId").value
                    item.County = document.querySelector("#objProjectCase_County").value
                    item.StateName = document.querySelector("#objProjectCase_StateId").value;
                    item.StateShortName = document.querySelector("#StateShortName").value;
                    item.Ste_Apt = document.querySelector("#objProjectCase_apartment").value;
                    item.ZipCode = document.querySelector("#objProjectCase_ZipCode").value;
                }

                if (item.id > 0) {
                    data[index] = item;
                } else {
                    var s = grid.dataSource.sort();
                    data.forEach(function(_datum){
                        _datum.xCaption='b';
                    });
                    item.xCaption='a';
                    data[index] = item;
                    grid.dataSource.sort({ field: "xCaption", dir: "asc" });
                }
                grid.dataSource.data(data);
        }
        // if its USA address then validate it
        if (["us", "united states", "usa", "united states of america"].includes(country.toLowerCase())) {
            let addressToValidate = {
                address1: address1,
                city: city,
                county: county,
                state: state,
                shortstate: shortstate,
                zip: zip,
                country: country
            }
            validateAddressWithUSPS(addressToValidate);
        }
    }
    function SaveAddress(EntityId, AddressTypeId, callback) {
        var addressDto = {
            AddressId:addressId,
            AddressTypeId: AddressTypeId,
            EntityId: EntityId,
            SecondryEntityId: 0,
            Apartment: $("#objProjectCase_apartment").val(),
            Street_Address: $("#objProjectCase_Address").val(),
            Country: $("#objProjectCase_CountryId").val(),
            City: $("#objProjectCase_CityId").val(),
            State: $("#objProjectCase_StateId").val(),
            StateShortName: $("#StateShortName").val(),
            County: $("#objProjectCase_County").val(),
            ZipCode: $("#objProjectCase_ZipCode").val(),
            Longitude: longitude,
            Latitude: latitude,
            Creator: resourceId,
            Updater: resourceId
        };
        if ($("#landmark").length) {
            addressDto.Landmark = $("#landmark").val();
        }
        if ($("#directions").length) {
            addressDto.Directions = $("#directions").val();
        }

        console.log(JSON.stringify(addressDto));

        $.ajax({
             beforeSend: function (request) {
                        request.setRequestHeader("Authorization", "Bearer " + token);
            },
            type: "POST",
            contentType: "application/json; charset=utf-8",
            url: APIBaseURL + urlPost,
            data: JSON.stringify(addressDto),
            success: function (dropDownDTOs) {
                if (callback) {
                    callback();
                }
            }
        });
    }

    function validateAddressWithUSPS(addressToValidate, callback) {

        const payload = {
            address1: addressToValidate.address1,
            city: addressToValidate.city,
            state: addressToValidate.shortstate,
            zip: addressToValidate.zip
        };

        fetch("/USPS/ValidateAddress", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
        })
            .then(r => r.json())
            .then(res => {

                if (!res || !res.success || !res.data) {
                    return callback && callback();
                }

                const d = res.data;

                d.zip && $("#objProjectCase_ZipCode").val(d.zip);
                d.city && $("#objProjectCase_CityId").val(d.city);
                d.county && $("#objProjectCase_County").val(d.county);
                d.state && $("#objProjectCase_StateId").val(d.state);
                d.shortState && $("#StateShortName").val(d.shortState);
                d.country && $("#objProjectCase_CountryId").val(d.country);

                callback && callback();
            })
            .catch(() => callback && callback());
    }

    $(document).on("Address.Reset", function (e,data) {
        var _gridTable = null;

        if (data && data.type==6) {
            _gridTable = gridTable + '2';
            data.gridTable = _gridTable;
            data.GridID = '[name="StreetAddress"]';
            data.GridID2 = '#StreetAddress';
        }
        data = data || {};
        initAutocomplete(_gridTable,data);
    });
    $(document).off('blur', '[name="Street_Address"]').on('blur', '[name="Street_Address"]', function () {

        if ($(this).val().trim() == "") {
            if (document.querySelector("#objProjectCase_ZipCode")) {
                document.querySelector("#objProjectCase_ZipCode").value = '';
            }
            if (document.querySelector("#objProjectCase_CityId")) {
                document.querySelector("#objProjectCase_CityId").value = '';
            }
            if (document.querySelector("#objProjectCase_StateId")) {
                document.querySelector("#objProjectCase_StateId").value = '';
                document.querySelector("#StateShortName").value = '';
            }
            if (document.querySelector("#objProjectCase_County")) {
                document.querySelector("#objProjectCase_County").value = '';
            }
            if (document.querySelector("#objProjectCase_CountryId")) {
                document.querySelector("#objProjectCase_CountryId").value = '';
            }
            if (document.querySelector("#objProjectCase_Address")) {
                document.querySelector("#objProjectCase_Address").value = '';
            }
        }
      });
</script>

<style type="text/css">
    * [START maps_places_autocomplete] */
    /* Always set the map height explicitly to define the size of the div
       * element that contains the map. */
    #map {
        height: 100%;
    }

    /* Optional: Makes the sample page fill the window. */
    html,
    body {
        height: 100%;
        margin: 0;
        padding: 0;
    }

    #description {
        font-family: Roboto, sans-serif;
        font-size: 15px;
        font-weight: 300;
    }

    #infowindow-content .title {
        font-weight: bold;
    }

    #infowindow-content {
        display: none;
    }

    #map #infowindow-content {
        display: inline;
    }

    .pac-card {
        margin: 10px 10px 0 0;
        border-radius: 2px 0 0 2px;
        box-sizing: border-box;
        -moz-box-sizing: border-box;
        outline: none;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
        background-color: #fff;
        font-family: Roboto, sans-serif;
    }

    #pac-container {
        padding-bottom: 12px;
        margin-right: 12px;
    }

    .pac-controls {
        display: inline-block;
        padding: 5px 11px;
    }

        .pac-controls label {
            font-family: Roboto, sans-serif;
            font-size: 13px;
            font-weight: 300;
        }

    #pac-input {
        background-color: #fff;
        font-family: Roboto, sans-serif;
        font-size: 15px;
        font-weight: 300;
        margin-left: 12px;
        padding: 0 11px 0 13px;
        text-overflow: ellipsis;
        width: 400px;
    }

        #pac-input:focus {
            border-color: #4d90fe;
        }

    #title {
        color: #fff;
        background-color: #4d90fe;
        font-size: 25px;
        font-weight: 500;
        padding: 6px 12px;
    }

    /* [END maps_places_autocomplete] */
</style>
<style>
    .pac-container {
        z-index: 10000 !important;
    }

    ::-ms-clear {
        display: none;
    }

    .form-control-clear {
        z-index: 10;
        pointer-events: auto;
        cursor: pointer;
    }
</style>
